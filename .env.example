# Copy to .env and adjust. Never commit .env.

# Admin connection, used only by `safesql setup-db` and the Spider loader.
SAFESQL_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/safesql
SAFESQL_READER_PASSWORD=change-me

# The MCP server connects with the read-only role.
SAFESQL_DATABASE_URL=postgresql://safesql_reader:change-me@localhost:5432/safesql
SAFESQL_SCHEMAS=spider_concert_singer

# Guardrails
SAFESQL_MAX_ROWS=200
SAFESQL_MAX_COST=50000
SAFESQL_STATEMENT_TIMEOUT_MS=5000

# Agent (only needed for `safesql ask` and the LLM evals)
ANTHROPIC_API_KEY=
SAFESQL_MODEL=claude-opus-5-5
SAFESQL_EFFORT=medium

# Observability: point at any OTLP/HTTP collector (docker compose ships Jaeger on 4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SAFESQL_OTEL_CONSOLE=1
